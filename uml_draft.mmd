classDiagram
    class Owner {
        +str name
        +list pets
        +add_pet(pet)
    }
    class Pet {
        +str name
        +str species
        +list tasks
        +add_task(task)
    }
    class Task {
        +str description
        +str time
        +str frequency
        +bool completed
        +mark_complete()
    }
    class Scheduler {
        +Owner owner
        +get_all_tasks()
        +sort_by_time()
    }
    Owner "1" o-- "*" Pet : has
    Pet "1" o-- "*" Task : has
    Scheduler --> Owner : uses
